# --- Security (Cloud Deploy) ---
# Chave de segurança para proteger endpoints HTTP (/chat, /sync)
API_KEY=your_secure_api_key_here

# --- LLM Providers (Multi-Provider Hybrid Architecture) ---
# OpenAI API Key (Fast model / Router / Whisper / Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Smart model / Deep reasoning / Obsidian Markdown)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
MAEVE_FAST_MODEL=gpt-5.6-luna
MAEVE_SMART_MODEL=claude-3-5-sonnet-20241022

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://local-vector-db:6333
# QDRANT_API_KEY=optional_key

# --- External Integrations ---
OBSIDIAN_REPO_URL=git@github.com:youruser/your-vault.git
OBSIDIAN_VAULT_PATH=/app/obsidian_vault

NOTION_API_KEY=your_notion_api_key_here
TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# --- Persistence (Supabase) ---
SUPABASE_DB_URL=postgresql://postgres.youruser:yourpassword@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Web Search (Tavily) ---
TAVILY_API_KEY=your_tavily_api_key_here

