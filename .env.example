# --- Security (Cloud Deploy & Remote MCP) ---
# Chave de segurança para proteger endpoints HTTP (/chat, /sync)
API_KEY=your_secure_api_key_here
# Token secreto para autenticar conexões remotas do Antigravity ao servidor MCP (/mcp/sse)
MAEVE_MCP_SECRET=your_mcp_bearer_token_here

# --- LLM Providers (Multi-Provider Hybrid Architecture) ---
# OpenAI API Key (Fast model / Router / Whisper / Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Smart model / Deep reasoning / Obsidian Markdown)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
MAEVE_FAST_MODEL=gpt-5.6-luna
MAEVE_SMART_MODEL=claude-3-5-sonnet-20241022

# --- Timezone & Localization ---
# Fuso horário para garantir hora correta em nuvem (Railway/Docker em UTC)
TIMEZONE=America/Sao_Paulo

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://local-vector-db:6333
# QDRANT_API_KEY=optional_key

# --- External Integrations ---
OBSIDIAN_REPO_URL=git@github.com:youruser/your-vault.git
OBSIDIAN_VAULT_PATH=/app/obsidian_vault

TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret
TICKTICK_ACCESS_TOKEN=your_ticktick_access_token_here
# Token para o servidor oficial MCP do TickTick (se disponível)
TICKTICK_MCP_TOKEN=optional_ticktick_mcp_token_here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# --- Persistence (Supabase) ---
SUPABASE_DB_URL=postgresql://postgres.youruser:yourpassword@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Web Search & Cultural Hub ---
TAVILY_API_KEY=your_tavily_api_key_here
# TMDB API Key (Opcional, para enriquecimento de pôsteres e fichas técnicas no Hub Cultural)
# TMDB_API_KEY=your_tmdb_api_key_here

# --- Git SSH Deployment (Opcional para Cloud/Railway) ---
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
